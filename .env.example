# Copy to .env for local development, then replace the placeholder secret.
API_KEY=local-trader
API_SECRET=replace-with-at-least-32-random-characters
CLIENT_API_KEYS='{"local-trader":"replace-with-the-same-secret"}'

# Local etcd v3 JSON gateway and isolated state namespace.
ETCD_ENDPOINTS=http://127.0.0.1:2379
ETCD_PREFIX=/p2p-exchange/local-dev
NODE_ID=local-dev

# Grenache Grape HTTP API and engine WebSocket service port.
GRAPE_URL=http://127.0.0.1:30001
PORT=1337

# Leave empty for local etcd without authentication. Remote etcd requires HTTPS and a token.
ETCD_AUTH_TOKEN=
